# Solo servidor. Nunca uses el prefijo NEXT_PUBLIC_ para secretos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (sin barra final). En local: http://localhost:3000 (OAuth de Google exige https en producción)
APP_URL=

# Tu correo: solo esta cuenta podrá entrar
ALLOWED_EMAIL=

# OAuth de Google (YouTube). Redirect URI: ${APP_URL}/api/connect/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Agencia de webs locales ---
# Tu nombre, para firmar los mensajes de contacto
SENDER_NAME=
# Precio mensual que se muestra (debe coincidir con el precio creado en Stripe), p. ej. 79
PLAN_PRICE_EUR=
# Stripe: clave secreta, secreto del webhook (${APP_URL}/api/stripe/webhook) e id del precio mensual (price_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Días de prueba gratuita antes del primer cobro (0 = sin prueba). Por defecto 30
TRIAL_DAYS=30
# Datos del titular del servicio. Sin los cuatro, el alta pública en /webs permanece cerrada
LEGAL_NAME=
LEGAL_NIF=
LEGAL_ADDRESS=
LEGAL_EMAIL=
